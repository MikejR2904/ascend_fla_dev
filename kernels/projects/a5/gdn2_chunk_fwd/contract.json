      "dtype": "float32",
      "shape": [
        "B",
        "T",
        "H",
        128
      ],
      "note": "Already-activated non-positive per-key-channel log decay."
    },
    "erase_gate": {
      "dtype": "float32",
      "shape": [
        "B",
        "T",
        "H",
        128
      ],
      "note": "Activated erase gate in [0,2]."
    },
    "w": {
      "dtype": "float32",
      "shape": [
        "B",
        "T",
        "H",
        128
      ],
      "note": "Already-activated write gate in [0,1]."
    },
    "initial_state": {
      "dtype": "float32",
      "shape": [
        "B",
        "H",
        128,
        128
      ],
      "note": "K-major, read-only and never aliased with final_state."
    }
  },
  "outputs": {
    "o": {
      "dtype": "float32",
      "shape": [
        "B",
        "T",
        "H",
        128
      ],
      "initialization": "NaN poison; every element must be overwritten."
    },
    "final_state": {
      "dtype": "float32",
      "shape": [
        "B",
        "H",
        128,
        128
      ],
      "initialization": "NaN poison; every element must be overwritten."
    }
  },
  "domain": {
    "B": [
      1
    ],
    "T": "1..4096",
    "H": [
      1,
      16
    ],
    "K": 128,
    "V": 128,
    "block_dim": [
      1,
      2,
      4,
      8
    ],
    "layout": "Token-major BTHD inputs/output; K-major BHKV state; all tensors contiguous.",
    "gate_domain": "Finite g<=0, erase_gate in [0,2], w in [0,1].",
    "normalization": "q and k are normalized in FP32 with eps=1e-6; q is then scaled by 128^-0.5.",
    "ownership": "Independent complete chunk/head tiles; scan owns complete heads across chunks.",
    "aliasing": "Inputs are read-only; o and final_state are fresh complete-overwrite outputs with disjoint storage."
  },
