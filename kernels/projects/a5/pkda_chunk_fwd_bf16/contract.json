      1,
      2
    ],
    "T": "1..4096",
    "H": "1..32",
    "K": 128,
    "V": 128,
    "block_dim": [
      1,
      2,
      3,
      4
    ],
    "layout": "Token-major BTHD inputs/output; K-major BHKV state; all tensors contiguous.",
    "gate_domain": "Finite g/g_atk<=0, beta/beta_atk in[0,1], initial_A_state>=0; per-chunk |sum(g)|<=155; key row L2<=1+1e-5.",
    "normalization": "None: pinned naive consumes q/k as supplied. Cases explicitly generate normalized input; runtime never normalizes.",
    "ownership": "Prepare and scan own complete heads across chunks; other stages own chunk/head tiles.",
    "aliasing": "All inputs read-only; all three outputs fresh and disjoint."
  },
