      "dtype": "float32",
      "shape": [
        "B",
        "T",
        "H",
        128
      ]
    },
    "g": {
      "dtype": "float32",
      "shape": [
        "B",
        "T",
        "H",
        128
      ],
      "note": "Already-activated non-positive per-key-channel log decay."
    },
    "initial_state": {
      "dtype": "float32",
      "shape": [
        "B",
        "H",
        128,
        128
      ],
      "note": "K-major, read-only and never aliased with final_state."
    },
    "g_atk": {
      "dtype": "float32",
      "shape": [
        "B",
        "T",
        "H"
      ]
    },
    "beta_atk": {
      "dtype": "float32",
      "shape": [
        "B",
        "T",
        "H"
      ]
    },
    "beta": {
      "dtype": "float32",
      "shape": [
        "B",
        "T",
        "H"
      ]
    },
    "initial_A_state": {
      "dtype": "float32",
      "shape": [
        "B",
        "H",
        128
      ],
      "note": "Independent non-negative ATK state, read-only."
    },
    "log_atk_scale": {
      "dtype": "float32",
      "shape": [
        "H"
      ]
    }
  },
  "outputs": {
    "o": {
      "dtype": "float32",
      "shape": [
        "B",
        "T",
        "H",
        128
      ],
      "initialization": "NaN poison; every element must be overwritten."
    },
    "final_state": {
      "dtype": "float32",
      "shape": [
        "B",
        "H",
        128,
        128
      ],
      "initialization": "NaN poison; every element must be overwritten."
    },
    "final_A_state": {
      "dtype": "float32",
      "shape": [
        "B",
        "H",
        128
      ],
      "initialization": "NaN poison; full overwrite."
    }
  },
  "domain": {
    "B": [
      1,
      2
    ],
    "T": "1..4096",
    "H": "1..32",
    "K": 128,
    "V": 128,
    "block_dim": [
      1,
      2,
      3,
      4
    ],
    "layout": "Token-major BTHD inputs/output; K-major BHKV state; all tensors contiguous.",
    "gate_domain": "Finite g/g_atk<=0, beta/beta_atk in[0,1], initial_A_state>=0; per-chunk |sum(g)|<=155; key row L2<=1+1e-5.",
    "normalization": "None: pinned naive consumes q/k as supplied. Cases explicitly generate normalized input; runtime never normalizes.",
    "ownership": "Prepare and scan own complete heads across chunks; other stages own chunk/head tiles.",
    "aliasing": "All inputs read-only; all three outputs fresh and disjoint."
  },
  "dependencies": {
    "python": ">=3.10",
