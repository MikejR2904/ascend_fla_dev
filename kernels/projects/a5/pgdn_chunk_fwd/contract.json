      "dtype": "float32",
      "shape": [
        "B",
        "T",
        "H"
      ],
      "note": "ATK update in [0,1]."
    }
  },
  "outputs": {
    "o": {
      "dtype": "float32",
      "shape": [
        "B",
        "T",
        "HV",
        128
      ],
      "initialization": "NaN poison; every element must be overwritten."
    },
    "final_state": {
      "dtype": "float32",
      "shape": [
