{
  "schema": "ascriptor.kernel-unit/1",
  "id": "a5.kda_layout",
  "kind": "kernel",
  "description": "Bit-preserving KDA layout movement, BF16/FP32 casts and default zero fill",
  "inputs": {
    "source": {
      "description": "BF16 or FP32 storage span selected explicitly by each case source parameter; ignored for zero fill"
    }
  },
  "outputs": {
    "destination": {
      "shape": [
        1,
        "N"
      ],
      "description": "dtype equals each case destination parameter; reference and actual dtype, shape and all bytes must match"
    }
  },
  "domain": {
    "block_dim": [
      1,
      2,
      3,
      4
    ],
    "layout": "five positive logical dimensions with final dimension a multiple of64; nonnegative element strides; disjoint contiguous destination",
    "ownership": "GetVecNum=2bd; each work item owns64 output elements; input read-only",
    "precision": "same-dtype copies preserve bits; BF16 widening exact; FP32->BF16 ties-to-even; optional existing FP32 gate multiplier has no FMA",
    "public_scope": "unchanged chunk K/V128,L64,gate155/105; registered DPM42 arithmetic exceptions remain outside this unit"
  },
  "dependencies": {
    "python": ">=3.10",
    "ascriptor": "==0.1.0",
    "host": [
      "torch>=2.9.1",
      "numpy"
    ]
  },
  "comparison": {
    "default": {
      "mode": "bitwise",
      "reason": "exact predecessor layout and cast boundary, no error tolerance"
    }
  },
